<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup is capped at 25 MB per app. A single Piper voice model is 20-110 MB, so leaving
   filesDir at its default (included) makes the system call onQuotaExceeded() and drop the whole
   backup - including the SharedPreferences that hold the reading position. Exclude the model
   directories so the small stuff still gets backed up. Voices are re-downloadable anyway.
-->
<data-extraction-rules>
    <!-- readoutloud_local.xml holds only last_uri. A content:// permission is device-local, so the
         value is worthless both after a cloud restore and after a device transfer. Excluding works
         per file, not per key, which is why it lives in its own store. See AppSettings.localPrefs. -->
    <cloud-backup>
        <exclude domain="file" path="voices" />
        <exclude domain="file" path="espeak-ng-data" />
        <exclude domain="sharedpref" path="readoutloud_local.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="voices" />
        <exclude domain="file" path="espeak-ng-data" />
        <exclude domain="sharedpref" path="readoutloud_local.xml" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and lower. Same reasoning as data_extraction_rules.xml: Piper voice models blow the
   25 MB Auto Backup quota, which kills the entire backup rather than just skipping the big files.
-->
<full-backup-content>
    <exclude domain="file" path="voices" />
    <exclude domain="file" path="espeak-ng-data" />
</full-backup-content>
